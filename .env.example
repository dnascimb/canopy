# Copy to .env and adjust. All variables are optional.

# Flask secret key used to sign session cookies and CSRF tokens. REQUIRED in production.
CANOPY_SECRET_KEY=change-me

# SQLAlchemy database URL. Defaults to a SQLite file in ./instance/canopy.db
# CANOPY_DATABASE_URL=sqlite:////absolute/path/to/canopy.db

# Override "today" (YYYY-MM-DD). Useful for demos, screenshots and tests.
# CANOPY_TODAY=2026-09-07

# Default flowering duration (days) used when creating groups and strains.
# CANOPY_DEFAULT_FLOWER_DAYS=70

# Per-plant footprint in square feet, "small,medium,large", used to estimate how many
# plants fit a space at each stage. Defaults: clone 0.1,0.15,0.2 · veg 0.5,0.75,1 · flower 1.5,2.25,3
# CANOPY_FOOTPRINT_CLONE=0.1,0.15,0.2
# CANOPY_FOOTPRINT_VEG=0.5,0.75,1
# CANOPY_FOOTPRINT_FLOWER=1.5,2.25,3
